jtml 2

let draftTitle = ""
let draftDescription = ""
let draftSeverity = ""
let requestKey = ""
let issueList = fetch "/api/issues" stale keep cache "no-store" timeout 5000 refresh reloadIssues
let saveResult = fetch "/api/issues" method "POST" body { title: draftTitle, description: draftDescription, severity: draftSeverity, request_key: requestKey } cache "no-store" timeout 5000 stale keep lazy refresh submitIssue
get saving = saveResult.loading
get loadingIssues = issueList.loading
get current = saveResult.hasData && (!issueList.hasData || saveResult.data.revision >= issueList.data.revision) ? saveResult.data : issueList.data

when newIssue
  draftTitle = ""
  draftDescription = ""

style
  .releasedesk
    max-width: 1040px
    margin: 40px auto
    padding: 24px
    font-family: system-ui, sans-serif
    color: #172b38
    line-height: 1.5
  header
    display: grid
    gap: 10px
    margin-bottom: 28px
  p
    margin: 0
  label
    display: grid
    gap: 6px
  .workspace
    display: grid
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr))
    gap: 32px
    align-items: start
  .intro
    color: #415968
  .editor
    border: 1px solid #cad5db
    border-radius: 10px
    padding: 20px
    background: #f5f8fa
  .fields
    display: grid
    gap: 10px
    border: 0
    margin: 0
    padding: 0
  input
    font: inherit
    padding: 10px
    border: 1px solid #617987
    border-radius: 4px
    width: 100%
    box-sizing: border-box
  textarea
    font: inherit
    padding: 10px
    border: 1px solid #617987
    border-radius: 4px
    width: 100%
    box-sizing: border-box
    resize: vertical
  select
    font: inherit
    padding: 10px
  button
    font: inherit
    padding: 10px 14px
    cursor: pointer
  .hint
    font-size: 0.9rem
    color: #415968
  .notice
    padding: 12px
    border-left: 4px solid #156348
    background: #edf8f2
  .failure
    padding: 12px
    border-left: 4px solid #a4262c
    background: #fff0ef
  .issues
    list-style: none
    padding: 0
  .filters
    display: grid
    gap: 12px
    margin: 16px 0
    padding: 16px
    border: 1px solid #cad5db
    border-radius: 10px
    background: #f5f8fa
  .filter-status
    margin: 12px 0
    color: #415968
  .no-results
    padding: 16px
    border: 1px dashed #617987
    border-radius: 6px
  .issue
    border-top: 1px solid #cad5db
    padding: 16px 0
    overflow-wrap: anywhere
  .description
    white-space: normal
  .description [data-jtml-expr]
    white-space: pre-wrap
  .metadata
    font-size: 0.9rem
    color: #415968

page class "releasedesk"
  header
    p "LOCAL RELEASE WORKSPACE"
    h1 "ReleaseDesk"
    p "Keep release blockers and regressions in one durable issue list. Stored in SQLite on this computer." class "intro"
  box class "workspace"
    section class "editor" aria-label "New issue"
      h2 "New issue"
      p "All fields are required. Title: up to 120 characters. Description: up to 4000 characters. Whitespace-only text is not accepted." class "hint"
      p "Save issue safely retries the current request. Use Start a separate issue only when you intend another record." class "hint"
      box role "alert" data-create-protection "true"
        text "Preparing safe issue creation…"
      form submit submitIssue aria-label "Create issue" data-create-form "true"
        input type "hidden" into requestKey data-request-key "true"
        fieldset class "fields" disabled=saving
          label "Title"
            input into draftTitle required maxlength "120" data-draft-title "true"
          label "Description"
            textarea into draftDescription required maxlength "4000" rows "5" data-draft-description "true"
          label "Severity"
            select into draftSeverity required aria-label "Severity" data-draft-severity "true"
              option "Choose severity…" value ""
              option "Low" value "low"
              option "Medium" value "medium"
              option "High" value "high"
              option "Critical" value "critical"
          button "Save issue" type "submit" disabled data-create-submit "true"
          button "Start a separate issue" type "button" disabled data-new-create-intent "true"
      box data-create-feedback "true"
        if saving
          box role "status"
            text "Saving issue…"
        if saveResult.error
          box class "failure" role "alert" data-testid "save-error"
            strong "Issue was not confirmed saved."
            p "Your draft is kept. After a network or database error, Save issue reuses the pending request so a retry cannot create a duplicate. Reload issues to inspect the saved list."
            p "If the response is 409 Conflict, this request already created an issue with different fields. Restore those fields to confirm it, or choose Start a separate issue only if you intend another record."
            p "API response: {saveResult.error}"
        if saveResult.ok
          box class "notice" role "status" data-testid "save-success" data-confirmed-key saveResult.data.request_key
            strong "Last confirmed save: Issue {saveResult.data.created.id} — {saveResult.data.created.title}"
            p "Stored in SQLite. Repeating Save issue with the same fields confirms this issue again."
            p "If this issue is hidden by your filters, choose Clear filters to find it."
            button "Clear text for next issue" click newIssue data-clear-create-intent "true"
    section aria-label "Saved issues" data-issue-browser "true"
      h2 "Saved issues"
      form class "filters" aria-label "Filter saved issues" data-issue-filters "true" hidden
        label "Search issues"
          input type "search" data-issue-query "true" placeholder "Search title or description" autocomplete "off"
        label "Filter by severity"
          select data-issue-severity "true" aria-label "Filter by severity"
            option "All severities" value ""
            option "Low" value "low"
            option "Medium" value "medium"
            option "High" value "high"
            option "Critical" value "critical"
        p "Matches title or description, ignoring case. Search and severity work together." class "hint"
        button "Clear filters" type "button" data-clear-filters "true"
      p class "filter-status" role "status" aria-live "polite" aria-atomic "true" data-filter-status "true" hidden
      box class "no-results" data-testid "no-results" data-no-results "true" hidden
        strong "No issues match your filters."
        p "Try a different search or severity, or choose Clear filters."
      button "Reload issues" click reloadIssues disabled=loadingIssues
      if loadingIssues
        box role "status"
          text "Loading issues…"
      if issueList.error
        box class "failure" role "alert" data-testid "load-error"
          strong "Could not load issues."
          p "Check that the local server is running, then choose Reload issues. Any last confirmed list below may be out of date."
          p "API response: {issueList.error}"
      box data-issue-results "true"
        if issueList.hasData || saveResult.hasData
          if current.issues.length == 0
            box data-testid "empty-state"
              text "No issues yet. Capture your first release blocker or regression."
          else
            list class "issues" aria-label "Saved issues"
              for issue in current.issues
                item class "issue" data-testid "issue" data-issue-title issue.title data-issue-severity issue.severity
                  h3 "Issue {issue.id} — {issue.title}"
                  p "Severity: {issue.severity} · Open · {issue.created_at}" class "metadata"
                  box class "description"
                    text issue.description
  footer
    p "Local development tool · No accounts or cloud sync · Back up the SQLite file before deleting local data." class "hint"
  html raw "<script src=\"./public/issue-filters.js\" defer></script>"
  html raw "<script src=\"./public/issue-create.js\" defer></script>"
