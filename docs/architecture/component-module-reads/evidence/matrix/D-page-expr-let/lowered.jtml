@template data-jtml-component-def="Probe" data-jtml-component-def-params="" data-jtml-component-def-emits="" data-jtml-component-def-emit-arity="" data-jtml-component-def-emit-payloads="" data-jtml-component-def-emit-payload-types="" data-jtml-source-line="2" data-jtml-component-body-hex=""\\
#

@main\\
    @div data-jtml-instance="Probe_1" data-jtml-component="Probe" data-jtml-instance-id="1" data-jtml-component-locals="dark=__Probe_1_dark;toggle=__Probe_1_toggle;tone=__Probe_1_tone" data-jtml-component-params="" data-jtml-source-line="11" data-jtml-component-args-hex="7b7d"\\
        define __Probe_1_dark = false\\
        derive __Probe_1_tone = __Probe_1_dark ? "dark" : "light"\\
        function __Probe_1_toggle()\\
            __Probe_1_dark = !__Probe_1_dark\\
        \\
        @main class=__Probe_1_dark\\
            @p\\
                show "Probe"\\
            #
            @button onClick=__Probe_1_toggle() type="button"\\
                show "Toggle"\\
            #
        #
    #
#
