jtml 2

use { SiteNav, SiteFooter, SitePages } from "./shared/layout.jtml"

make ToolsPage
  box class "website content-page"
    a "Skip to content" href "#page-start" class "skip-link"
    SiteNav "./index.html#syntax" "./index.html#demo"
    main
      SitePages
      section class "page-hero" aria-labelledby "tools-title"
        p "Local toolkit" class "eyebrow"
        h1 "A local experimental toolkit." id "tools-title"
        p "JTML ships as a local CLI with Studio, runner, tutorial IDE, checker, formatter, linter, smoke tester, VS Code support, static site artifact builder, release packager, and predeploy verification."
      section aria-labelledby "tools-grid-title"
        box class "section-heading"
          p "Commands" class "eyebrow"
          h2 "One binary, several loops." id "tools-grid-title"
        box class "example-grid tool-grid"
          article class "example-card"
            h3 "Runner"
            p "Serve a JTML file with HTTP, WebSocket updates, and event fallback."
            code "jtml serve examples/friendly_counter.jtml --port 8000 --watch"
          article class "example-card"
            h3 "Tutorial IDE"
            p "Launch guided lessons with editable code and live preview."
            code "jtml tutorial --port 8000"
          article class "example-card"
            h3 "Studio"
            p "Open the native Studio with Run, Lint, Fix, Format, Export HTML, diagnostics, compiler artifacts, command palette, autosaved drafts, versioned local Save/history, and live preview."
            code "jtml demo --port 8000"
          article class "example-card"
            h3 "Tester"
            p "Parse, lint, transpile, and smoke-test every bundled example."
            code "jtml test"
          article class "example-card"
            h3 "Doctor"
            p "Check the local toolkit folders, scripts, tutorial, site, editor assets, and emit JSON for CI."
            code "jtml doctor --json"
          article class "example-card"
            h3 "Static Build"
            p "Compile a file or app folder to a distributable static HTML output."
            code "jtml build examples/friendly_import_page.jtml --target browser --out dist/app"
          article class "example-card"
            h3 "Release Kit"
            p "Create the predeploy site artifact and local CLI release archive."
            code "scripts/verify_all.sh"
          article class "example-card"
            h3 "Install"
            p "Install the CLI into a prefix for team machines or build images."
            code "cmake --install build --prefix ~/.local"
          article class "example-card"
            h3 "Package"
            p "Generate a local release directory, archive, manifest, and checksums."
            code "scripts/package_cli.sh dist/release"
      section class "try-section" aria-labelledby "predeploy-title"
        box class "section-heading"
          p "Predeploy" class "eyebrow"
          h2 "Build everything locally." id "predeploy-title"
          p
            span " These scripts stop one step before publishing a public domain. They produce local artifacts under "
            code "dist/"
            span ". "
        box class "steps"
          article class "step"
            span "1" class "step-number"
            h3 "Verify"
            pre
              code "scripts/verify_all.sh"
          article class "step"
            span "2" class "step-number"
            h3 "Build Site"
            pre
              code "scripts/build_site.sh dist/site"
          article class "step"
            span "3" class "step-number"
            h3 "Package CLI"
            pre
              code "scripts/package_cli.sh dist/release"
      box class "legacy-links"
        a "Get started" href "./index.html#try"
    box class "footer-note"
      a "Apache-2.0 (JTML-owned material)" href "https://www.apache.org/licenses/LICENSE-2.0"
      span "JTML"
      span "Local tools ready before public deployment."
    SiteFooter

ToolsPage
