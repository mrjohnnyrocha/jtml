jtml 2

make Probe
  let enabled = true
  let item = { left: 2, right: 9 }
  let alias = item
  get result = enabled ? alias.left : item.right
  when left
    item.left += 1
  when right
    item.right += 2
  when disable
    enabled = false
  when enable
    enabled = true
  box class "probe"
    p class "out-result" result
    button "left" click left
    button "right" click right
    button "disable" click disable
    button "enable" click enable

page
  Probe
