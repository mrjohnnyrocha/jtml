jtml 2

make LargeKeyedUpdates
  let offset = 0

  when updateRows
    if offset == 0
      offset = 100
    else
      offset = 0

  panel title "Large keyed updates"
    button "Update rows" click updateRows
    for index in 1..1000 key index
      card title "Row {index + offset}" tone neutral
        text "Row {index + offset}"

page
  LargeKeyedUpdates
