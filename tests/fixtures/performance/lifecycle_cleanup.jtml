jtml 2

make Badge label emits pinged(name)
  box class "badge"
    button label click pinged(label)

make LifecycleDemo
  let visible = true
  let lastPing = ""
  get rows = visible ? ["alpha"] : []

  when remember source name
    lastPing = source + ":" + name

  when cycle
    visible = !visible

  box class "lifecycle"
    h2 "Lifecycle cleanup"
    button "Cycle" click cycle
    if visible
      box class "child"
        Badge "Mounted" on pinged remember("child")
    else
      text "Nested child removed"
    for item in rows key item
      box class "row"
        text item

page
  LifecycleDemo
