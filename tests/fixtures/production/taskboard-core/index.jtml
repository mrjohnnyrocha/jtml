jtml 2

# C01–C14 interactive workflow. Canonical records and every record write belong to TaskBoard.
make TaskStatus boardTitle completed
  get status = completed ? "Complete" : "Open"
  box class "task-status-detail" title status data-completed completed data-board-title boardTitle
    box class "board-heading" title boardTitle
      show boardTitle
    box class "task-status"
      show status

make TaskHeader boardTitle record
  box class "task-header" title boardTitle
    h2 record.title
    TaskStatus boardTitle record.completed

make TaskRow boardTitle record boardId emits titleSaved(id: string, value: string) noteSaved(id: string, value: string) movedDown(id: string) movedUp(id: string) toggled(id: string) deleted(id: string)
  let draftTitle = record.title
  let draftNote = record.note
  let editing = false
  let interactions = 0
  let titleError = ""
  get titleInvalid = titleError != ""
  get editId = "edit-title-" + boardId + "-" + record.id
  get titleErrorId = "title-error-" + boardId + "-" + record.id
  # Alt+F8 / Alt+F7 move the row without leaving its focused input.
  when reorderKey event
    if event.altKey && event.key == "F8"
      movedDown(record.id)
    if event.altKey && event.key == "F7"
      movedUp(record.id)
  when increment
    interactions += 1
  when saveNote
    noteSaved(record.id, draftNote)
  when editTitle
    editing = true
  when cancelTitle
    draftTitle = record.title
    editing = false
    titleError = ""
  when saveTitle
    let trimmed = ""
    let pending = ""
    let whitespace = false
    # Keep the complete Unicode whitespace set explicit for title validation.
    # Native text inputs remove CR/LF; preserve internal whitespace verbatim.
    for character in draftTitle
      whitespace = false
      for blank in " 	                 　﻿"
        if character == blank
          whitespace = true
      if whitespace
        if trimmed != ""
          pending = pending + character
      else
        trimmed = trimmed + pending + character
        pending = ""
    if trimmed == ""
      titleError = "Enter a task title"
    else
      draftTitle = trimmed
      titleError = ""
      editing = false
      titleSaved(record.id, trimmed)
  card class "task-row" data-task-id record.id data-editing editing
    TaskHeader boardTitle record
    button "Edit title" id editId click editTitle
    form class "edit-title" submit saveTitle
      input class "row-draft" aria-label "Task title draft" aria-describedby titleErrorId aria-invalid titleInvalid value draftTitle into draftTitle
      button "Save title" type "submit"
      button "Cancel title" type "button" click cancelTitle
      box class "title-error" id titleErrorId role "alert"
        show titleError
    form class "save-note" submit saveNote
      input class "row-note" aria-label "Task note draft" value draftNote into draftNote keydown reorderKey
      button "Save note" type "submit"
    box class "saved-note"
      show record.note
    button "Delete task" click deleted(record.id)
    button "Toggle complete" click toggled(record.id)
    button "Move down" title "Alt+F8" click movedDown(record.id)
    button "Move up" title "Alt+F7" click movedUp(record.id)
    button "Increment" class "increment" click increment
    box class "interaction-count"
      show interactions

make BranchProbe label
  let count = 0
  when increment
    count += 1
  box class "branch-probe" title label
    box class "branch-label"
      show label
    button "Increment branch" click increment
    box class "branch-count"
      show count

make Help
  let count = 0
  when increment
    count += 1
  aside class "help"
    p "Taskboard help"
    button "Increment help" click increment
    box class "help-count"
      show count

make TaskBoard boardId
  let title = "Before"
  let filter = "All"
  let fallback = "Fallback A"
  let help = false
  let renameDraft = "Before"
  let focusSelector = "#create-title-" + boardId
  let records = { "t-101": { "id": "t-101", "title": "Audit runtime", "completed": false, "note": "" }, "t-102": { "id": "t-102", "title": "Audit runtime", "completed": false, "note": "" }, "t-103": { "id": "t-103", "title": "Ship documentation", "completed": true, "note": "" }, "t-104": { "id": "t-104", "title": "<release> & CSP", "completed": false, "note": "" } }
  let order = ["t-101", "t-102", "t-103", "t-104"]
  # Parent-maintained completion index; rebuilt from records in canonical order.
  let completeIds = ["t-103"]
  let issuedIds = { "t-101": true, "t-102": true, "t-103": true, "t-104": true }
  let dataError = ""
  let selectedId = "t-101"
  let selectedSuffix = "!"
  let selectedFallback = "Unselected"
  let selectedGuard = false
  get selectedTitle = records[selectedId].title + selectedSuffix
  get selectedLabel = selectedGuard ? selectedTitle : selectedFallback
  let nextId = 105
  let draft = ""
  let error = ""
  let titleSaveCount = 0
  let noteSaveCount = 0
  let submitCount = 0
  get logicalFlag = title == "After" && help
  get ternaryLabel = help ? title : fallback
  get total = order.length
  get complete = completeIds.length
  get open = total - complete
  get remaining = total - complete
  get completionLabel = remaining == 0 ? "All complete" : "Work remains"
  get visible = filter == "All" ? total : filter == "Open" ? open : complete
  get inputId = "create-title-" + boardId
  get errorId = "create-error-" + boardId
  get invalid = error != ""

  # Explicit test-data/model boundary. Validate the entire batch before any
  # canonical write. Imported values are scalar copies, never borrowed records.
  # This in-memory Taskboard uses the same t-<digits> ID domain as its allocator.
  when acceptBatch supplied
    let batchError = ""
    let seenIds = {}
    for candidate in supplied
      let idText = "" + candidate.id
      let idValid = idText.length > 2 && idText[0] == "t" && idText[1] == "-" && candidate.id.length == idText.length
      let idPosition = 0
      for idCharacter in idText
        if idPosition >= 2
          let digitFound = false
          for digit in "0123456789"
            if idCharacter == digit
              digitFound = true
          if !digitFound
            idValid = false
        idPosition += 1
      if !idValid || seenIds[idText]
        batchError = "Invalid task IDs"
      if idValid && !seenIds[idText]
        seenIds[idText] = true
        if issuedIds[idText] && !records[idText]
          batchError = "Task ID was already used"
    if batchError != ""
      dataError = batchError
    else
      let acceptedRecords = {}
      let acceptedOrder = []
      let acceptedComplete = []
      for accepted in supplied
        let copiedId = "" + accepted.id
        let copiedTitle = "" + accepted.title
        let copiedNote = "" + accepted.note
        let copiedCompleted = !(!accepted.completed)
        acceptedRecords[copiedId] = { "id": copiedId, "title": copiedTitle, "note": copiedNote, "completed": copiedCompleted }
        acceptedOrder[acceptedOrder.length] = copiedId
        if copiedCompleted
          acceptedComplete[acceptedComplete.length] = copiedId
        issuedIds[copiedId] = true
      records = acceptedRecords
      order = acceptedOrder
      completeIds = acceptedComplete
      dataError = ""

  when replaceEquivalent
    let equivalentRecords = {}
    for equivalentId in order
      equivalentRecords[equivalentId] = { "id": records[equivalentId].id, "title": records[equivalentId].title, "note": records[equivalentId].note, "completed": records[equivalentId].completed }
    records = equivalentRecords

  when ownedProperty
    records["t-101"].title = "First owned"

  when ownedIndex
    records[selectedId].title = "Indexed owned"

  when ownedAlias
    let selectedRecord = records[selectedId]
    selectedRecord.title = selectedRecord.title + " alias"

  when selectGuard
    selectedGuard = !selectedGuard

  when changeTaskId originalId requestedId
    if originalId != requestedId
      dataError = "Task IDs are immutable"

  when rename
    title = renameDraft

  when changeFallback
    fallback = "Fallback B"

  when toggleHelp
    help = !help

  when create
    submitCount += 1
    let trimmed = ""
    let pending = ""
    let whitespace = false
    # Keep the complete Unicode whitespace set explicit for title validation.
    # Native text inputs remove CR/LF; preserve internal whitespace verbatim.
    for character in draft
      whitespace = false
      for blank in " 	                 　﻿"
        if character == blank
          whitespace = true
      if whitespace
        if trimmed != ""
          pending = pending + character
      else
        trimmed = trimmed + pending + character
        pending = ""
    if trimmed == ""
      error = "Enter a task title"
    else
      let createdId = "t-" + nextId
      while issuedIds[createdId]
        nextId += 1
        createdId = "t-" + nextId
      issuedIds[createdId] = true
      records[createdId] = { "id": createdId, "title": trimmed, "completed": false, "note": "" }
      order[order.length] = createdId
      nextId += 1
      draft = ""
      error = ""

  when onlyOpen
    filter = "Open"

  when onlyComplete
    filter = "Complete"

  when showAll
    filter = "All"

  when toggle id
    records[id].completed = !records[id].completed
    let nextComplete = []
    for completeId in order
      if records[completeId].completed
        nextComplete[nextComplete.length] = completeId
    completeIds = nextComplete

  when moveDown id
    let downIndex = 0
    let downDone = false
    let downNext = ""
    while downIndex < order.length - 1
      if order[downIndex] == id && !downDone
        downNext = order[downIndex + 1]
        order[downIndex + 1] = order[downIndex]
        order[downIndex] = downNext
        downDone = true
      downIndex += 1

  when moveUp id
    let upIndex = 1
    let upDone = false
    let upPrevious = ""
    while upIndex < order.length
      if order[upIndex] == id && !upDone
        upPrevious = order[upIndex - 1]
        order[upIndex - 1] = order[upIndex]
        order[upIndex] = upPrevious
        upDone = true
      upIndex += 1

  when removeTask id
    let keptOrder = []
    let keptRecords = {}
    let keptComplete = []
    let removedIndex = 0
    for keptId in order
      if keptId != id
        keptOrder[keptOrder.length] = keptId
        keptRecords[keptId] = records[keptId]
        if records[keptId].completed
          keptComplete[keptComplete.length] = keptId
      else
        removedIndex = keptOrder.length
    order = keptOrder
    records = keptRecords
    completeIds = keptComplete
    if order.length == 0
      focusSelector = "#create-title-" + boardId
    else
      let focusIndex = removedIndex
      if focusIndex >= order.length
        focusIndex = order.length - 1
      focusSelector = "#edit-title-" + boardId + "-" + order[focusIndex]

  when commitNote id value
    records[id].note = "" + value
    noteSaveCount += 1

  when commitTitle id value
    records[id].title = "" + value
    titleSaveCount += 1

  section class "taskboard" data-board boardId data-jtml-focus-after-removal focusSelector
    h1 title
    box class "data-boundary"
      h2 "Test data boundary"
      input aria-label "Selected task ID" value selectedId into selectedId
      input aria-label "Selected suffix" value selectedSuffix into selectedSuffix
      input aria-label "Selected fallback" value selectedFallback into selectedFallback
      box class "selected-title"
        show selectedTitle
      box class "selected-label"
        show selectedLabel
      button "Enable selected label" click selectGuard
      button "Owned property title" click ownedProperty
      button "Owned indexed title" click ownedIndex
      button "Owned alias title" click ownedAlias
      button "Equivalent task records" click replaceEquivalent
      box class "data-error" role "alert"
        show dataError
      # The independent browser oracle supplies JSON through this native event's
      # argument boundary. It never mutates records or calls runtime internals.
      button "Validate supplied data" click acceptBatch([])
      button "Mutate task ID" click changeTaskId("t-101", "t-999")
    form class "rename-board" submit rename
      input aria-label "Board title" value renameDraft into renameDraft
      button "Rename board" type "submit"
    button "Change fallback" click changeFallback
    button "Toggle help" click toggleHelp
    if title == "After"
      BranchProbe title
    else
      BranchProbe fallback
    box class "logical-flag"
      show logicalFlag
    box class "ternary-label"
      show ternaryLabel
    box class "remaining"
      show remaining
    box class "completion-label"
      show completionLabel
    if help
      Help
    button "All" class "filter-all" click showAll
    button "Open" class "filter-open" click onlyOpen
    button "Complete" class "filter-complete" click onlyComplete
    if total == 0
      box class "empty-board" role "status"
        text "No tasks"
    if total > 0 && visible == 0
      box class "empty-filter" role "status"
        text "No tasks match this filter"
    box class "counts"
      box class "count-total"
        show total
      box class "count-open"
        show open
      box class "count-complete"
        show complete
      box class "count-visible"
        show visible
    form class "create-task" submit create
      label "Task title" for inputId
      input class "create-title" id inputId aria-describedby errorId aria-invalid invalid value draft into draft
      button "Create task" type "submit"
      box class "create-error" id errorId role "alert"
        show error
    for taskId in order key taskId
      if filter == "All" || (filter == "Open" && !records[taskId].completed) || (filter == "Complete" && records[taskId].completed)
        TaskRow title records[taskId] boardId on titleSaved commitTitle on noteSaved commitNote on movedDown moveDown on movedUp moveUp on toggled toggle on deleted removeTask

page
  TaskBoard "A"
  TaskBoard "B"
